# Copy to config/channels.local.env. Never commit the local file.
# At least 32 random characters. This is the only token clients use.
GATEWAY_API_KEY=replace-with-a-long-random-value

# Optional local-only CPA management key. Leave empty to disable Management API.
CPA_MANAGEMENT_KEY=

# Channel IDs must match config/routes.local.json. Values may contain URL paths such as /v1.
CHANNEL_FREE_NAME=Free
CHANNEL_FREE_BASE_URL=https://example.invalid/v1
CHANNEL_FREE_API_KEY=replace-me
# Supported: openai-compatible, responses, claude
CHANNEL_FREE_PROTOCOL=openai-compatible
CHANNEL_FREE_ENABLED=false

# Repeat CHANNEL_<ID>_* for each upstream channel.
