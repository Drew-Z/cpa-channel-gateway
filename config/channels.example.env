# Copy to config/channels.local.env. Never commit the local file.
# At least 32 random characters. This is the only token clients use.
GATEWAY_API_KEY=replace-with-a-long-random-value

# Optional local-only admin key for /admin. Leave empty to disable the admin UI.
# Use a separate random value of at least 32 characters; it is not a model API key.
CPA_MANAGEMENT_KEY=

# Optional remotely managed Cloudflare Tunnel. Keep disabled until the dashboard
# tunnel exists and its token has been added only to the local file.
CLOUDFLARE_TUNNEL_ENABLED=false
CLOUDFLARE_TUNNEL_TOKEN=

# Channel IDs must match config/routes.local.json. Values may contain URL paths such as /v1.
CHANNEL_SAMPLE_NAME=Sample Channel
CHANNEL_SAMPLE_BASE_URL=https://example.invalid/v1
CHANNEL_SAMPLE_API_KEY=replace-me
# Supported: openai-compatible, responses, claude
CHANNEL_SAMPLE_PROTOCOL=openai-compatible
CHANNEL_SAMPLE_ENABLED=false

# Repeat CHANNEL_<ID>_* for each upstream channel.
