{
  "name": "cpa-channel-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Single-tenant CPA and HAProxy gateway for constrained upstream channels",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:admin": "vite build --config admin/vite.config.ts",
    "check:admin-dist": "node scripts/check-admin-dist.mjs",
    "prestart": "npm run build:admin",
    "check": "node scripts/gateway.mjs validate",
    "audit:public": "node scripts/public-audit.mjs",
    "generate": "node scripts/gateway.mjs generate",
    "activate": "node scripts/gateway.mjs activate",
    "rollback": "node scripts/gateway.mjs rollback",
    "status": "node scripts/gateway.mjs status",
    "import:legacy": "node scripts/import-legacy-env.mjs",
    "merge:legacy": "node scripts/import-legacy-env.mjs --merge",
    "replace:legacy": "node scripts/import-legacy-env.mjs --replace",
    "migrate:providers": "node scripts/migrate-providers.mjs",
    "migrate:routes": "node scripts/migrate-routes.mjs",
    "sync:models": "node scripts/sync-models.mjs",
    "canary": "node scripts/canary.mjs",
    "audit:channel-models": "node scripts/audit-channel-models.mjs",
    "apply:channel-audit": "node scripts/apply-channel-audit.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "install:runtime": "node scripts/install-runtime.mjs",
    "start": "node scripts/gateway.mjs start",
    "test": "npm run build:admin && node --test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
